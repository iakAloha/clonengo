<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="clonengo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:clonengo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="clonengo - Käyttäjäprofiilien kopiointi">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <MenuBar x:Name="MainMenu" Grid.Row="0">
        <MenuBarItem Title="Asetukset">
            <MenuFlyoutItem Text="Kopioitavat sijainnit..." Click="LocationsMenu_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutSubItem Text="Teema">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </MenuFlyoutSubItem.Icon>
                <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Tumma" GroupName="Theme" IsChecked="True" Tag="Dark" Click="ThemeMenu_Click" />
                <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Vaalea" GroupName="Theme" Tag="Light" Click="ThemeMenu_Click" />
                <RadioMenuFlyoutItem x:Name="ThemeDefault" Text="Järjestelmän mukainen" GroupName="Theme" Tag="Default" Click="ThemeMenu_Click" />
            </MenuFlyoutSubItem>
        </MenuBarItem>
    </MenuBar>

    <Grid Grid.Row="1" Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Otsikko -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Käyttäjäprofiilit" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="DescriptionText"
                           Text="Kopioi valitut käyttäjäprofiilit tiedostoon."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Toiminnon valinta -->
        <StackPanel x:Name="ModePanel" Grid.Row="1" Spacing="8">
            <TextBlock Text="Toiminto" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <RadioButtons x:Name="ModeSelector"
                          MaxColumns="2"
                          SelectedIndex="0"
                          SelectionChanged="ModeSelector_SelectionChanged">
                <RadioButton Content="Kopioi tiedostoon" />
                <RadioButton Content="Palauta tiedostosta" />
            </RadioButtons>
        </StackPanel>

        <!-- Tiedoston polku -->
        <StackPanel x:Name="FilePanel" Grid.Row="2" Spacing="8">
            <TextBlock x:Name="FileLabel" Text="Kohdetiedosto" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathBox"
                         PlaceholderText="Valitse tiedosto..."
                         IsReadOnly="True" />
                <Button Grid.Column="1" Content="Selaa..." Click="BrowseButton_Click" />
            </Grid>
            <StackPanel x:Name="CompressPanel" Spacing="8">
                <TextBlock Text="Pakkaus" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="CompressionBox" MinWidth="320" SelectedIndex="2">
                    <ComboBoxItem Content="Ei pakkausta (nopein)" />
                    <ComboBoxItem Content="Zip (nopea, kohtalainen pakkaus)" />
                    <ComboBoxItem Content="7-Zip (paras pakkaus, hitaampi)" />
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Profiililista -->
        <Grid x:Name="ListPanel" Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock x:Name="ListLabel"
                           Text="Valitse kopioitavat profiilit"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Valitse kaikki" Click="SelectAll_Click" />
                    <Button Content="Tyhjennä valinta" Click="ClearSelection_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ListView x:Name="ProfileList"
                          SelectionMode="Multiple"
                          ItemsSource="{x:Bind Profiles}"
                          SelectionChanged="ProfileList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:UserProfileItem">
                            <Grid Padding="0,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Path}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind SizeText, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <!-- Toiminnot ja tila -->
        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="6">
                <TextBlock x:Name="StatusText"
                           Text="Ei valittuja profiileja"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="Progress" Value="0" Maximum="100" Visibility="Collapsed" />
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="RunButton"
                    Content="Kopioi"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    MinWidth="140"
                    Click="RunButton_Click" />
        </Grid>
    </Grid>
    </Grid>
</Window>
